{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2020",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "api/**/*.ts",
    "recommendations/**/*.ts",
    "scraping/supabase-node.ts",
    "scraping/database.ts",
    "scraping/utils.ts",
    "scraping/types.ts"
  ],
  "exclude": ["node_modules", "dist", "scraping/**/temp-pdfs"]
}
